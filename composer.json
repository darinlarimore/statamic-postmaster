{
    "name": "darinlarimore/statamic-postmaster",
    "description": "Newsletter subscriptions, MJML campaigns, and queued sendouts for Statamic",
    "type": "statamic-addon",
    "license": "proprietary",
    "keywords": ["statamic", "statamic-addon", "newsletter", "email", "mjml", "campaigns"],
    "autoload": {
        "psr-4": {
            "Darinlarimore\\Postmaster\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Darinlarimore\\Postmaster\\Tests\\": "tests"
        }
    },
    "require": {
        "statamic/cms": "^5.0|^6.0",
        "php": "^8.2",
        "spatie/mjml-php": "^1.2"
    },
    "require-dev": {
        "pestphp/pest": "*",
        "pestphp/pest-plugin-laravel": "*",
        "mockery/mockery": "*",
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "laravel/pint": "^1.26",
        "laravel/boost": "^2.4"
    },
    "config": {
        "allow-plugins": {
            "pixelfear/composer-dist-plugin": true,
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "statamic": {
            "name": "Statamic Email Subscribe",
            "description": "Newsletter subscriptions, MJML campaigns, and queued sendouts for Statamic"
        },
        "laravel": {
            "providers": [
                "Darinlarimore\\Postmaster\\ServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "format": "vendor/bin/pint",
        "format:check": "vendor/bin/pint --test"
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
